{
  "name": "ai-journey-land",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm clean && pnpm build:fresh && turbo run dev --parallel",
    "build": "turbo run build",
    "build:fresh": "turbo run build --force",
    "clean": "rm -rf .turbo apps/api/dist apps/web/.nuxt apps/web/.output packages/*/dist",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "changelog": "standard-version --skip.bump --skip.commit --skip.tag",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "standard-version": "^9.5.0",
    "turbo": "2.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "22.18.0",
    "pnpm": ">=11.0.8"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
