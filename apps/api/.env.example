# ============================================================================
# AI-Journey-Land 后端环境变量模板
# ============================================================================
# 使用方式：cp .env.example .env 然后填入真实值
#
# ⚠️  安全警告：
#  - .env 文件包含 API 密钥，已被 .gitignore 排除，请勿提交到仓库
#  - 所有密钥仅保存在后端，前端不得直接读取或调用 AI provider
#  - 生产环境请使用 CI/CD 注入或 Secret Manager，不要手动编辑 .env
# ============================================================================

# ---------------------------------------------------------------------------
# 服务端口
# ---------------------------------------------------------------------------

# NestJS 后端监听端口
API_PORT=5044

# 前端域名（用于 CORS 白名单）
WEB_ORIGIN=http://localhost:5033

# ---------------------------------------------------------------------------
# AI Provider 选择
# ---------------------------------------------------------------------------
# 可选值：deepseek | glm | qiniu | qwen
# 每个 provider 只需配置对应的 *_API_KEY，baseUrl 和 modelName 已有内置默认值。
# 如需覆盖默认 baseUrl 或 modelName，可配置对应的 *_BASE_URL / *_MODEL_NAME。
AI_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# DeepSeek 配置
# ---------------------------------------------------------------------------
# 默认 baseUrl：https://api.deepseek.com
# 默认模型列表：deepseek-v4-pro, deepseek-v4-flash（默认取第一个）
DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-v4-pro

# ---------------------------------------------------------------------------
# GLM（智谱）配置
# ---------------------------------------------------------------------------
# 默认 baseUrl：https://open.bigmodel.cn/api/paas/v4
# 默认模型列表：glm-4-flash, glm-4-plus（默认取第一个）
# GLM_API_KEY=xxx
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL_NAME=glm-4-flash

# ---------------------------------------------------------------------------
# 七牛云配置
# ---------------------------------------------------------------------------
# 默认 baseUrl：https://api.qnaigc.com/v1
# 默认模型：deepseek/deepseek-v3.2-exp-thinking
# QINIU_API_KEY=xxx
# QINIU_BASE_URL=https://api.qnaigc.com/v1
# QINIU_MODEL_NAME=deepseek/deepseek-v3.2-exp-thinking

# ---------------------------------------------------------------------------
# Qwen（通义千问 / DashScope）配置
# ---------------------------------------------------------------------------
# 默认 baseUrl：https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型：qwen3.6-plus
# QWEN_API_KEY=xxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_NAME=qwen3.6-plus

# ---------------------------------------------------------------------------
# 以下为未来阶段的预留配置，当前暂不启用：
# ---------------------------------------------------------------------------
# JWT_SECRET=your-jwt-secret
# AMAP_MAPS_API_KEY=your-amap-key
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
