# ============================================================================
# AI-Journey-Land 后端环境变量模板
# ============================================================================
# 使用方式：cp .env.example .env 然后填入真实值
#
# ⚠️  安全警告：
#  - .env 文件包含 API 密钥，已被 .gitignore 排除，请勿提交到仓库
#  - 所有密钥仅保存在后端，前端不得直接读取或调用 AI provider
#  - 生产环境请使用 CI/CD 注入或 Secret Manager，不要手动编辑 .env
# ============================================================================

# ---------------------------------------------------------------------------
# 服务端口
# ---------------------------------------------------------------------------

# NestJS 后端监听端口
API_PORT=3001

# 前端域名（用于 CORS 白名单）
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Provider 选择
# ---------------------------------------------------------------------------
# 可选值：openai | deepseek
# openai 模式下读取 OPENAI_* 环境变量
# deepseek 模式下读取 DEEPSEEK_* 环境变量
AI_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# OpenAI-compatible 配置（DashScope / Qwen / 等）
# 当 AI_PROVIDER=openai 时启用
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# ---------------------------------------------------------------------------
# DeepSeek 配置
# 当 AI_PROVIDER=deepseek 时启用
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# ---------------------------------------------------------------------------
# 以下为未来阶段的预留配置，当前暂不启用：
# ---------------------------------------------------------------------------
# JWT_SECRET=your-jwt-secret
# AMAP_MAPS_API_KEY=your-amap-key
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# EMBEDDINGS_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDINGS_MODEL_NAME=text-embedding-v3
# EMBEDDINGS_API_KEY=sk-xxx
