{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 90,
  "useTabs": false,
  "tabWidth": 2,
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "bracketSpacing": true,
  "bracketSameLine": true,
  "jsxSingleQuote": false,
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "insertFinalNewline": true,
  "ignorePatterns": [
    ".git/**",
    ".turbo/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "apps/web/.nuxt/**",
    "apps/web/.output/**",
    "apps/api/dist/**",
    "packages/*/dist/**",
    "pnpm-lock.yaml"
  ]
}
